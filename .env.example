# Copy to `.env` for local development. `.env` is git-ignored: never commit it.
# Nothing in this file is secret. Harmony needs no API keys or passwords in its
# configuration except the LiveKit key below, which stays on the server only.

# Address the server listens on. Keep it on localhost behind a reverse proxy.
HARMONY_BIND=127.0.0.1:8080

# Where the SQLite database and uploads live.
HARMONY_DATA_DIR=./data

# Where the built web app lives.
HARMONY_WEB_DIR=../web/dist

# Session cookies are HTTPS-only by default. Set to false only for local development over http.
HARMONY_COOKIE_SECURE=false

# Voice calls (optional). Calls are off unless all three are set.
# The address browsers use to reach LiveKit, e.g. wss://harmony.example.com
# when your reverse proxy sends /rtc to LiveKit. See docs/voice.md.
# HARMONY_LIVEKIT_URL=
# The key name and secret from LiveKit's own config file. Put the real values
# only in the server's environment, never in this file or in git.
# HARMONY_LIVEKIT_API_KEY=
# HARMONY_LIVEKIT_API_SECRET=
