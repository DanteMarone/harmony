{
  "name": "harmony-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --manifest-path ../crypto/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen ../crypto/target/wasm32-unknown-unknown/release/harmony_crypto.wasm --target web --out-dir wasm",
    "dev": "vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  }
}
